OPENAI_API_KEY=sk-...
PORT=8181

# Bot Configuration (optional - defaults to config/bot.json)
# Uncomment to override config/bot.json values
# BOT_NAME=DemoBot
# PERSON_NAME=Demo Company
# BOT_PUBLIC_URL=https://bot.example.com
# BOT_DESCRIPTION=AI assistant for Demo Company

# Secret for signing/verifying JWT API keys for /api/public
# Generate with: openssl rand -hex 32
# Then create keys with: bun run apikey:create --name "client" --expires-in "1y"
CHATBOT_SECRET=your-secret-hex-string-here

# Staff JWT via JWKS (preferred) or PEM
# For Clerk: Use your Clerk JWKS URL: https://<your-clerk-domain>/.well-known/jwks.json
JWT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
JWT_ISSUER=https://auth.example.com/
JWT_AUDIENCE=bot.example.com
# JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n....

# Clerk Config (for /private HTML client)
# Get your publishable key from https://dashboard.clerk.com
# For custom Clerk domains, also set CLERK_FRONTEND_URL to your custom domain
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_FRONTEND_URL=https://clerk.example.com

# Rate limits (requests per minute)
RATE_LIMIT_RPM_PUBLIC=60
RATE_LIMIT_RPM_PRIVATE=120

# Turso (libsql) Database
TURSO_URL=libsql://<db>.turso.io
TURSO_AUTH_TOKEN=...

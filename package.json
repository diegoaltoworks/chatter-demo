{
  "name": "chatter-demo",
  "version": "1.0.0",
  "description": "Demo implementation of Chatter - AI chatbot framework with RAG support",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "test": "NODE_ENV=test bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test",
    "apikey:create": "bun scripts/apikey-create.ts"
  },
  "keywords": ["chatbot", "chatter", "openai", "rag", "demo", "hono", "bun"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@diegoaltoworks/chatter": "^0.16.0",
    "@libsql/client": "^0.17.2",
    "hono": "^4.12.14",
    "jose": "^5.9.6",
    "openai": "^6.34.0",
    "undici": "^6.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.15",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
